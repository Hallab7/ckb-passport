{
  "name": "@ckb-passport/poc-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@ckb-passport/poc-workspace",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/demo": {
      "name": "@ckb-passport/demo",
      "version": "0.0.0"
    },
    "node_modules/@ckb-passport/demo": {
      "resolved": "apps/demo",
      "link": true
    },
    "node_modules/@ckb-passport/siwd-browser": {
      "resolved": "packages/siwd-browser",
      "link": true
    },
    "node_modules/@ckb-passport/siwd-core": {
      "resolved": "packages/siwd-core",
      "link": true
    },
    "node_modules/@ckb-passport/siwd-verify": {
      "resolved": "packages/siwd-verify",
      "link": true
    },
    "packages/siwd-browser": {
      "name": "@ckb-passport/siwd-browser",
      "version": "0.0.0"
    },
    "packages/siwd-core": {
      "name": "@ckb-passport/siwd-core",
      "version": "0.0.0"
    },
    "packages/siwd-verify": {
      "name": "@ckb-passport/siwd-verify",
      "version": "0.0.0"
    }
  }
}
