CKB_PASSPORT_NETWORK=ckb-testnet
CKB_RPC_URL=https://testnet.ckb.dev/rpc
CKB_INDEXER_URL=https://testnet.ckb.dev/indexer
CKB_DID_CODE_HASH=
CKB_DID_HASH_TYPE=
SIWD_EXPECTED_ORIGIN=http://localhost:3000
CKB_PASSPORT_DEMO_PORT=3000
CKB_PASSPORT_ENABLE_DID_UPDATE=0

# Optional live DID update gate. These are required only for `npm run update:did`.
CKB_PASSPORT_LIVE_DID=
CKB_PASSPORT_AUTH_KEY_ID=auth-1
CKB_PASSPORT_AUTH_DID_KEY=
CKB_PASSPORT_DID_LOCK_PRIVATE_KEY=
CKB_PASSPORT_UPDATE_TX_HASH=
CKB_PASSPORT_UPDATE_CAPACITY_SHANNONS=
